{
    "compilerOptions": {
        "strict": true,
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "outDir": "dist/",
        "esModuleInterop": true,
        "skipLibCheck": true,
    },
    "include": ["src"],
    "exclude": ["node_modules","dist"],
}